# Checkmate on EC2 (Podman) — /etc/checkmate/checkmate.env, chmod 600.
# Only DOMAIN is required to start; the rest can be set later in https://<DOMAIN>/admin → Settings
# (or by uploading this file there).

# The DNS name that points at this instance (A record → Elastic IP). Caddy gets its certificate for it.
DOMAIN=checkmate.example.com
ACME_EMAIL=you@example.com
PUBLIC_BASE_URL=https://checkmate.example.com

# Event
TZ=Asia/Dubai
EVENT_NAME=Checkmate
# auto = ask each visitor; or dubai | new-york | boston | singapore | melbourne
DEFAULT_CITY=auto
# Optional: otherwise generated on first start and printed once (podman logs checkmate).
ADMIN_PASSWORD=

# Checkmarx One: the API key is enough (tenant, region and URLs are read from it).
# auto: real Checkmarx One scans as soon as CX_API_KEY connects (demo without a key); live; demo
CX_MODE=auto
# AI Triage & Remediation: simulated (the same steps on the real findings, no AI credits) or live
ASSIST_MODE=simulated
CX_API_KEY=

# Email (invitations, "results are ready", the developer brief with fixes). EC2 blocks port 25: use 587/465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
TEAM_NOTIFY_EMAIL=

# Real city photographs from Wikimedia Commons at first start
CITY_PHOTOS_AUTO=true
