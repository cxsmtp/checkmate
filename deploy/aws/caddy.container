# Caddy in front of Checkmate: obtains and renews the HTTPS certificate (Let's Encrypt)
# for DOMAIN and forwards to the app on 127.0.0.1:3333. Needed for the location prompt
# and the links in invitation emails. Skip it if a load balancer already serves HTTPS.

[Unit]
Description=Caddy HTTPS front for Checkmate
Wants=network-online.target checkmate.service
After=network-online.target checkmate.service

[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2-alpine
Network=host
EnvironmentFile=/etc/checkmate/checkmate.env
Volume=/etc/checkmate/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=caddy-data:/data
Volume=caddy-config:/config
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
AutoUpdate=registry

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
