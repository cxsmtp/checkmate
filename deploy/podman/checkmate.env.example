# Checkmate settings for Podman. Copy to ~/.config/checkmate/checkmate.env (Linux)
# or checkmate.env next to your podman command (Windows / macOS), then: chmod 600.
# Everything except the update settings can also be changed later in /admin → Settings.

# --- Self-updating -----------------------------------------------------------
AUTO_UPDATE=on
UPDATE_CHECK_MINUTES=5
# Only while the image package is private: a GitHub token (classic: read:packages) so the
# container can read new images and their signatures.
UPDATE_REGISTRY_TOKEN=
GITHUB_READ_TOKEN=

# --- Event --------------------------------------------------------------------
TZ=Asia/Dubai
# The https address visitors use (needed for location themes and email links).
PUBLIC_BASE_URL=
EVENT_NAME=Checkmate
# auto = ask each visitor; or fix one city: dubai | new-york | boston | singapore | melbourne
DEFAULT_CITY=auto
# Optional: otherwise generated on first start and printed in the log.
ADMIN_PASSWORD=

# --- Checkmarx One (live mode) ---------------------------------------------
# The API key is enough: tenant, region, IAM and API URLs are read from it.
# (Both can also be pasted in /admin → Settings, or this file uploaded there.)
CX_MODE=demo
CX_API_KEY=

# --- Email (invitations, results, the developer brief with fixes) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
TEAM_NOTIFY_EMAIL=

# --- City photographs from Wikimedia Commons (needs outbound HTTPS to
#     commons.wikimedia.org and upload.wikimedia.org; otherwise upload in /admin)
CITY_PHOTOS_AUTO=true
