# ---- General ---------------------------------------------------------------
PORT=3000
# Public URL used in invitation emails (the address attendees can reach).
PUBLIC_BASE_URL=http://localhost:3000
EVENT_NAME=Checkmate
DATA_DIR=data

# "demo" simulates a scan with sample findings; "live" uses the Checkmarx One tenant.
CX_MODE=demo

# ---- Checkmarx One tenant (live mode) --------------------------------------
# Regional URLs, e.g. https://eu.ast.checkmarx.net and https://eu.iam.checkmarx.net
CX_BASE_URL=https://ast.checkmarx.net
CX_IAM_URL=https://iam.checkmarx.net
CX_TENANT=
# Use EITHER an API key...
CX_API_KEY=
# ...OR an OAuth client.
CX_CLIENT_ID=
CX_CLIENT_SECRET=
CX_PROJECT_PREFIX=checkmate-
CX_DEFAULT_BRANCH=main
CX_ENGINES=sast,sca,kics,apisec
# JSON array merged into the scan config to switch Fusion on for these scans.
# Set it to whatever your tenant uses to enable Fusion, for example:
# CX_FUSION_SCAN_CONFIG=[{"type":"sast","value":{"fusion":"true"}}]
CX_FUSION_SCAN_CONFIG=
CX_POLL_INTERVAL_MS=15000
CX_SCAN_TIMEOUT_MS=2700000
# Optional token so Checkmarx One can clone private GitHub repositories.
CX_GITHUB_TOKEN=

# Results whose type/engine/source contains one of these are treated as Fusion results.
FUSION_RESULT_MARKERS=fusion,ai-sast,aisast,ai_sast

# ---- Plain-language explanations (optional) ---------------------------------
# Without a key, the built-in explanations are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
EXPLAIN_MAX_FINDINGS=40

# ---- Email (optional) -------------------------------------------------------
# Without SMTP, emails are written to $DATA_DIR/outbox as JSON.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Checkmarx Checkmate <no-reply@example.com>
# Internal address notified of every new registration.
TEAM_NOTIFY_EMAIL=
