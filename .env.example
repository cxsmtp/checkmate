# Checkmate — environment defaults. Everything here can also be set (and overrides this)
# in /admin → Settings, or by uploading this very file there (Settings → Configure from a .env file).
# Only two things are needed for a live booth: CX_API_KEY and the SMTP_* settings.

# ---- General ---------------------------------------------------------------
PORT=3000
# The address visitors use (email links; https is needed for the location prompt).
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=data
TRUST_PROXY=loopback
# Admin password (otherwise generated on first start and printed once).
ADMIN_PASSWORD=
# demo = simulated scans, triage and fixes (rehearsal); live = the Checkmarx One tenant.
CX_MODE=demo

# ---- Checkmarx One ------------------------------------------------------------
# The API key is enough: tenant, region, IAM and API URLs are read from it.
CX_API_KEY=
# Overrides, normally left empty (single-tenant / private deployments only).
CX_BASE_URL=
CX_IAM_URL=
CX_TENANT=
CX_ALLOW_CUSTOM_HOST=false
CX_PROJECT_PREFIX=checkmate-
CX_DEFAULT_BRANCH=main
CX_POLL_INTERVAL_MS=15000
CX_SCAN_TIMEOUT_MS=2700000
# Optional token so Checkmarx One can clone private GitHub repositories.
CX_GITHUB_TOKEN=

# ---- What a Checkmate scan runs ----------------------------------------------
CX_ENGINES=sast,sca,kics,apisec
CX_FUSION=true
# Empty: the tenant's default; the visitor sees the tenant's list (e.g. opus-5.5, mythos-5.1).
CX_FUSION_LLM_MODEL=
CX_SAST_EXTENDED_ANALYSIS=true
CX_SAST_PRESET=
SCAN_LET_VISITOR_CHOOSE=true
# Extra scan config entries (JSON array of {type, value}) merged last.
CX_FUSION_SCAN_CONFIG=

# ---- Fusion -----------------------------------------------------------------
FUSION_QUERY_ID_ZERO=true
FUSION_RESULT_MARKERS=fusion,ai-sast,aisast,ai_sast
FUSION_CORRELATE=true
# Base paths of the Fusion Dispatcher and Results services; empty = probe the usual candidates.
FUSION_DISPATCHER_PATH=
FUSION_RESULTS_PATH=
FUSION_TIMEOUT_MS=1200000

# ---- AI Triage & Remediation (the "close the loop" buttons) -------------------
ASSIST_ENABLED=true
ASSIST_POLL_INTERVAL_MS=8000
ASSIST_TIMEOUT_MS=1800000

# ---- Event, branding, city ---------------------------------------------------
EVENT_NAME=Checkmate
EVENT_TAGLINE=See what your scanner is missing.
EVENT_VENUE=
BRAND_APP_NAME=Checkmate
BRAND_COMPANY=Checkmarx
BRAND_LOGO_URL=
BRAND_ICON_URL=
BRAND_LOGO_HEIGHT=36
BRAND_ACCENT=
BRAND_ACCENT_NAME=city
BRAND_LOOK=command-center
BRAND_THEME=dark
BRAND_CTA=Bring your repository. In minutes, see what rule-based scanning never showed you.
BRAND_FOOTER=
# auto = ask each visitor; or dubai | new-york | boston | singapore | melbourne
DEFAULT_CITY=auto
ASK_LOCATION=true
# Fetch licensed city photographs from Wikimedia Commons at first start when missing.
CITY_PHOTOS_AUTO=true
SAMPLE_REUSE_HOURS=24
PROFILES_LOOKUP=true
PROFILES_MIN_CHARS=2

# ---- Email --------------------------------------------------------------------
# Without SMTP, emails are written to $DATA_DIR/outbox as JSON.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_AUTH=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Checkmate
# Booth team address notified of every registration.
TEAM_NOTIFY_EMAIL=

# ---- Updates & integrity (container) ----------------------------------------
AUTO_UPDATE=off
UPDATE_CHECK_MINUTES=5
UPDATE_IMAGE=ghcr.io/cxsmtp/checkmate
# Private repository: a token with read:packages, for the image and its attestations.
UPDATE_REGISTRY_TOKEN=
GITHUB_READ_TOKEN=
INTEGRITY_CHECK_HOURS=6
UPDATE_START_TIMEOUT_SECONDS=150
